# Template only — Step 9F-7D. No secrets in this file, and none are created
# by this change. It documents names/shape for the Windows + Caddy
# production deployment; real values live only in local, non-committed
# files that the runtime scripts under ops/windows/{api,caddy}/ read:
#
#   - Go API:            %LOCALAPPDATA%\GreenwichFireResponder\Api\api.env
#                         (KEY=VALUE lines; read by ops/windows/api/Run-Api.ps1)
#   - Production Postgres: a local env file passed to
#                         `docker compose -f compose.prod.yaml --env-file <file> ...`
#
# Recording ingestion / transcription / audio-analysis variables are
# unchanged from .env.example and are not duplicated here.

# --- Production PostgreSQL (compose.prod.yaml), loopback-only ---
POSTGRES_PROD_DB=greenwich_fire_responder_prod
POSTGRES_PROD_USER=gfr_prod
POSTGRES_PROD_PASSWORD=replace_me_with_a_unique_production_password
POSTGRES_PROD_PORT=5442

# --- Go API (copy into api.env above; the API reads process env only) ---
# Forced to 127.0.0.1:8080 by ApiRuntime.psm1 regardless of this value —
# the production API is never reachable except through Caddy's reverse proxy.
GFR_HTTP_ADDR=127.0.0.1:8080
GFR_DATABASE_REQUIRED=true
# Example shape only; point at the production Postgres instance above, not
# at the existing 127.0.0.1:5432 development database.
GFR_DATABASE_URL=postgres://gfr_prod:replace_me@127.0.0.1:5442/greenwich_fire_responder_prod?sslmode=disable

GFR_AUTH_ENABLED=true
GFR_AUTH_SESSION_IDLE_TIMEOUT=15m
GFR_AUTH_SESSION_MAX_LIFETIME=12h
GFR_AUTH_PASSWORD_RESET_TTL=1h
GFR_AUTH_INVITATION_TTL=168h
# High-entropy secret (32+ bytes), generated at actual deploy time, e.g.:
# openssl rand -base64 32. Never commit a real value.
GFR_AUTH_SESSION_SECRET=
GFR_AUTH_ALLOWED_ORIGINS=https://app.gfrapp.com
# Caddy and the API run on the same host and talk over loopback.
GFR_AUTH_TRUSTED_PROXIES=127.0.0.1,::1
GFR_AUTH_RATE_LIMIT_PER_ACCOUNT=5/15m
GFR_AUTH_RATE_LIMIT_PER_IP=20/15m
GFR_AUTH_RATE_LIMIT_INVITATION=10/1h
GFR_AUTH_RATE_LIMIT_PASSWORD_RESET=5/1h
GFR_AUTH_BREACH_CHECK_ENABLED=false
# WebAuthn passkey (MFA) relying-party identity — must match the production
# app origin above (RPID is the effective domain only: no scheme, no port).
GFR_AUTH_MFA_RP_ID=gfrapp.com
GFR_AUTH_MFA_RP_DISPLAY_NAME=Greenwich Fire Responder V3
