# Local environment and secrets; keep the safe templates tracked.
.env
.env.*
!.env.example
!.env.production.example
secrets/
.secrets/
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx

# `go build ./cmd/<tool>/...` on Windows writes a binary into the current
# directory when the pattern resolves to exactly one main package; never
# intentional to commit one of these.
*.exe

# Local database files and backups.
postgres_data/
pgdata/
data/
backups/
*.dump
*.backup
*.sql.gz

# Logs and temporary files.
logs/
*.log
*.log.*
tmp/
temp/
.tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# Private human-review material and generated dataset exports.
review-data/
dataset-exports/
*.jsonl
*.reference.txt
*.review.txt
*.experiment-summary.json
recordings/
*.mp3
*.wav

# iPhone Push Test preparation (pushtest/): the filled-in config carries a
# dev-only VAPID public key and the receiver's bearer token, and the
# received subscription itself carries endpoint/p256dh/auth -- none of this
# is ever committed. Only pushtest/web/config.example.js (placeholders
# only) is tracked.
pushtest/web/config.js
pushtest/*.subscription.json
pushtest/received/
