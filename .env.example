# Template only. Replace the password in your local .env before starting.
POSTGRES_DB=greenwich_fire_responder_dev
POSTGRES_USER=gfr_dev
POSTGRES_PASSWORD=replace_me_with_a_unique_local_password
POSTGRES_PORT=5432

# Go API settings: the API reads process environment variables, not this file.
GFR_HTTP_ADDR=127.0.0.1:8080
GFR_DATABASE_REQUIRED=false
# Leave empty to run without PostgreSQL. Example URL uses placeholders only:
# postgres://gfr_dev:replace_me@127.0.0.1:5432/greenwich_fire_responder_dev?sslmode=disable
GFR_DATABASE_URL=

# Recording ingestion is disabled unless a directory is explicitly configured.
# Windows example: C:\Users\User\SDRTrunk\recordings
# The Go API does not automatically load this file.
GFR_RECORDINGS_DIR=
GFR_RECORDING_TIMEZONE=America/New_York
GFR_RECORDING_POLL_INTERVAL=1s
GFR_RECORDING_STABLE_FOR=3s
GFR_RECORDING_MAX_WAIT=2m
GFR_RECORDING_RETRY_INTERVAL=5s
GFR_RECORDING_MAX_ATTEMPTS=3

# Audio analysis runs after stable recording metadata is ingested.
# Explicit executable paths can be used if PATH has not been refreshed.
GFR_FFPROBE_PATH=ffprobe
GFR_FFMPEG_PATH=ffmpeg
GFR_AUDIO_TIMEOUT=30s
GFR_AUDIO_MAX_DURATION=10m
GFR_AUDIO_MAX_ATTEMPTS=3
GFR_AUDIO_RETRY_INTERVAL=2s

# Optional remote transcription. Process environment only; disabled by default.
# Set BASE_URL privately to your trusted service; never embed credentials in it.
# Optional managed Windows whisper.cpp endpoint: http://127.0.0.1:8001
# Install separately using ops/windows/whisper/README.md; disabled remains default.
GFR_TRANSCRIPTION_ENABLED=false
GFR_TRANSCRIPTION_BASE_URL=
GFR_TRANSCRIPTION_MODEL=small.en
GFR_TRANSCRIPTION_LANGUAGE=en
GFR_TRANSCRIPTION_TIMEOUT=60s
GFR_TRANSCRIPTION_MAX_RESPONSE_BYTES=1048576
GFR_TRANSCRIPTION_MAX_AUDIO_BYTES=33554432
GFR_TRANSCRIPTION_MAX_ATTEMPTS=3
GFR_TRANSCRIPTION_RETRY_DELAY=5s
GFR_TRANSCRIPTION_BEARER_TOKEN=
GFR_TRANSCRIPTION_PROMPT=
GFR_TRANSCRIPTION_WORD_BOOST=

# Observational warnings only; no readiness, scheduling, unit or CAD effects.
GFR_MONITOR_WARN_QUEUE_DEPTH=10
GFR_MONITOR_WARN_OLDEST_AGE=30s
GFR_MONITOR_WARN_REQUEST_DURATION=15s
GFR_MONITOR_WARN_CONSECUTIVE_FAILURES=3

# Local transcript-review CLI only. Whole-command database deadline: 1s–30s.
# Uses the existing GFR_DATABASE_URL process setting; never loads .env itself.
# Reviewer labels and human confirmation must be supplied explicitly per submit.
GFR_REVIEW_DB_TIMEOUT=10s

# Step 9C authentication API. Disabled by default; enabling it requires
# GFR_DATABASE_URL and every value below to be set explicitly — there is no
# insecure default for any of them. Backend/API only: no login screen, no
# administrator Users screen, and no MFA enrollment exist yet (see
# docs/authentication-authorization-v1.md).
# The session cookie is always Secure, so a browser will only ever send it
# back over HTTPS (including https://localhost, which browsers treat as a
# secure context). Local development therefore needs an HTTPS front end
# (for example, `ng serve --ssl` or a local reverse proxy with a
# self-signed/mkcert certificate) — there is no insecure-cookie fallback
# for plain HTTP, in production or locally.
GFR_AUTH_ENABLED=false
GFR_AUTH_SESSION_IDLE_TIMEOUT=15m
GFR_AUTH_SESSION_MAX_LIFETIME=12h
GFR_AUTH_PASSWORD_RESET_TTL=1h
# High-entropy secret (32+ bytes), used to derive the CSRF token from the
# current session — never a session-signing key (Step 9B sessions are
# opaque and database-verified, not signed/stateless). Generate locally,
# e.g.: openssl rand -base64 32. Never commit a real value.
GFR_AUTH_SESSION_SECRET=
# Comma-separated exact browser origins (scheme://host[:port], no path)
# permitted to make state-changing authenticated requests.
GFR_AUTH_ALLOWED_ORIGINS=https://localhost:4200
# Comma-separated CIDRs/IPs of proxies trusted to supply X-Forwarded-For.
# Leave empty (the safe default) unless this API sits behind a real proxy.
GFR_AUTH_TRUSTED_PROXIES=
# <max-attempts>/<window-duration> rate limits.
GFR_AUTH_RATE_LIMIT_PER_ACCOUNT=5/15m
GFR_AUTH_RATE_LIMIT_PER_IP=20/15m
GFR_AUTH_RATE_LIMIT_INVITATION=10/1h
GFR_AUTH_RATE_LIMIT_PASSWORD_RESET=5/1h
# Must remain false: no breached-password-checking provider is implemented.
GFR_AUTH_BREACH_CHECK_ENABLED=false
