# Template only. Replace the password in your local .env before starting.
POSTGRES_DB=greenwich_fire_responder_dev
POSTGRES_USER=gfr_dev
POSTGRES_PASSWORD=replace_me_with_a_unique_local_password
POSTGRES_PORT=5432

# Go API settings: the API reads process environment variables, not this file.
GFR_HTTP_ADDR=127.0.0.1:8080
GFR_DATABASE_REQUIRED=false
# Leave empty to run without PostgreSQL. Example URL uses placeholders only:
# postgres://gfr_dev:replace_me@127.0.0.1:5432/greenwich_fire_responder_dev?sslmode=disable
GFR_DATABASE_URL=

# Recording ingestion is disabled unless a directory is explicitly configured.
# Windows example: C:\Users\User\SDRTrunk\recordings
# The Go API does not automatically load this file.
GFR_RECORDINGS_DIR=
GFR_RECORDING_TIMEZONE=America/New_York
GFR_RECORDING_POLL_INTERVAL=1s
GFR_RECORDING_STABLE_FOR=3s
GFR_RECORDING_MAX_WAIT=2m
GFR_RECORDING_RETRY_INTERVAL=5s
GFR_RECORDING_MAX_ATTEMPTS=3

# Audio analysis runs after stable recording metadata is ingested.
# Explicit executable paths can be used if PATH has not been refreshed.
GFR_FFPROBE_PATH=ffprobe
GFR_FFMPEG_PATH=ffmpeg
GFR_AUDIO_TIMEOUT=30s
GFR_AUDIO_MAX_DURATION=10m
GFR_AUDIO_MAX_ATTEMPTS=3
GFR_AUDIO_RETRY_INTERVAL=2s
